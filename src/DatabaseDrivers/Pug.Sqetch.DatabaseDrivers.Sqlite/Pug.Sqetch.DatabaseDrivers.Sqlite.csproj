<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Pug.Sqetch.DatabaseDrivers.Ado\Pug.Sqetch.DatabaseDrivers.Ado.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12"/>
    </ItemGroup>

    <ItemGroup>
        <!-- the journaling template 'sqetch journaling init' copies into a project; one file per slot -->
        <EmbeddedResource Include="Journaling\*.sql" LogicalName="journaling/%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
